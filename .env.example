# ============================================================
# ZYREX SQUAD AUTH — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# 1. PUBLIC SUPABASE CONFIGURATION (Safe for browser / client SDKs)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON=your-supabase-anon-key-here

# 2. SECRET SUPABASE CONFIGURATION (SERVER/EDGE FUNCTION ONLY — NEVER EXPOSE TO FRONTEND/SDK)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. NETLIFY & API DEPLOYMENT
NETLIFY_SITE_NAME=modz-auth-demo
FUNCTIONS_API_URL=https://your-project-id.supabase.co/functions/v1/api

# 4. LEGACY / SESSION SECRET (If running local Node express server.js)
SESSION_SECRET=modz_super_secret_session_key_12345
PORT=3000
